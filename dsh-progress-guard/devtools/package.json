{
  "name": "@local/dsh-devtools",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Bounded discovery, verified native diagnostics and identity-bound page inspection, activation and refresh.",
  "exports": { ".": "./index-v6.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["*.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "scripts/*.mjs", "scripts/*.cjs", "scripts/*.ps1", "tests/*.test.js"],
  "scripts": { "test": "node --test tests/*.test.js", "check": "node scripts/check.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true } }
}
