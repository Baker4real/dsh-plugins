{
  "name": "@local/dsh-goal-wait",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Persist goal waits and resume once on a human reply (optionally exact) or a verified receipt.",
  "exports": { ".": "./index-v2.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index-v2.js", "index.js", "state.js", "receipt.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "scripts/*.mjs", "scripts/*.ps1", "tests/*.js"],
  "scripts": { "check": "node scripts/check.mjs" },
  "engines": { "dsh": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.5" },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-chat"] }
  }
}
