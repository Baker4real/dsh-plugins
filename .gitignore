# Dependencies and tool caches
**/node_modules/
**/.pnpm-store/
**/.cache/
**/.okf-cache/
**/__pycache__/
**/*.pyc

# Runtime state and private evidence
**/.dsh-plugin-smoke/
**/.dsh-graph/
**/.scratch/
**/run-evidence/
**/test-results/
**/playwright-report/
**/coverage/
**/*.log
**/*.out.txt
**/*.err.txt
**/*.run.json

# Secrets and local configuration
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/.credentials.yaml
**/*.pem
**/*.key
**/auth.json
**/credentials.json

# Local editor and OS files
**/.DS_Store
**/Thumbs.db
**/*.tsbuildinfo
**/.idea/
**/.vscode/
