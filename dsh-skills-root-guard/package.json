{
  "name": "@local/dsh-skills-root-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deny direct write/edit tool calls that target the active skills root.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
